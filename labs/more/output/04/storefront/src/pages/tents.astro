---
import BaseLayout from '../layouts/BaseLayout.astro';
import { products } from '../data/products.js';
const tents = products.filter((product) => product.category === 'Tents');
const seasons = [...new Set(tents.map((product) => product.season))];
---
<BaseLayout title="All tents | Contoso Outdoors">
  <h1>All tents</h1>
  <form class="filters" aria-label="Filter tents">
    <label>Price
      <select id="price-filter">
        <option value="all">All prices</option>
        <option value="250">$250 or less</option>
        <option value="350">$350 or less</option>
      </select>
    </label>
    <label>Season
      <select id="season-filter">
        <option value="all">All seasons</option>
        {seasons.map((season) => <option value={season}>{season}</option>)}
      </select>
    </label>
  </form>
  <section class="catalog" aria-live="polite">
    {tents.map((product) => (
      <article class="product-card" data-price={product.price} data-season={product.season}>
        <a href={`/products/${product.slug}`}>
          <img src={product.image} alt={product.name} />
          <h2>{product.name}</h2>
          <p>{product.brand}</p>
          <strong>${product.price}</strong>
        </a>
      </article>
    ))}
  </section>
</BaseLayout>

<script>
  const priceFilter = document.querySelector('#price-filter');
  const seasonFilter = document.querySelector('#season-filter');
  const cards = document.querySelectorAll('.product-card');
  function filterCatalog() {
    cards.forEach((card) => {
      const matchesPrice = priceFilter.value === 'all' || Number(card.dataset.price) <= Number(priceFilter.value);
      const matchesSeason = seasonFilter.value === 'all' || card.dataset.season === seasonFilter.value;
      card.hidden = !(matchesPrice && matchesSeason);
    });
  }
  priceFilter.addEventListener('change', filterCatalog);
  seasonFilter.addEventListener('change', filterCatalog);
</script>

<style>
  h1 { margin-top: 0; }
  .filters { display: flex; gap: 16px; border: 1px solid var(--line); border-radius: 6px; padding: 16px; background: var(--surface); }
  label { display: grid; gap: 6px; font-weight: 700; }
  select { border: 1px solid var(--line); border-radius: 4px; padding: 8px; background: var(--surface-raised); color: var(--ink); }
  .catalog { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 24px; }
  .product-card { border: 1px solid var(--line); border-radius: 6px; background: var(--surface); box-shadow: var(--shadow); }
  .product-card:hover { border-color: var(--accent); }
  .product-card[hidden] { display: none; }
  .product-card a { height: 100%; display: grid; grid-template-rows: 220px auto auto auto; gap: 8px; padding: 16px; text-decoration: none; }
  .product-card img { width: 100%; height: 220px; object-fit: contain; }
  .product-card h2 { margin: 8px 0 0; font-size: 1.15rem; }
  .product-card p { margin: 0; }
  @media (max-width: 800px) { .catalog { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .catalog { grid-template-columns: 1fr; } .filters { flex-direction: column; } }
</style>
