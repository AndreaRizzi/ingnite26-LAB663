---
import BaseLayout from '../layouts/BaseLayout.astro';

const radioTranscript = 'Rain in the forecast? Bring it! The Trailmaster X4 from Outdoor Living sleeps four, stands up on its own, and comes with its own rainfly. Home, anywhere, for $250. Find it at Contoso Outdoors.';
---
<BaseLayout title="TrailMaster X4 Launch | Contoso Outdoors">
  <article class="launch">
    <header class="launch-header">
      <div>
        <p class="eyebrow">OutdoorLiving · $250</p>
        <h1>TrailMaster X4</h1>
        <p>A water-resistant, 4-person tent with a rainfly and a freestanding design.</p>
        <a href="/products/trailmaster-x4-tent">View product details</a>
      </div>
      <figure>
        <img src="/launch/launch-poster.webp" alt="TrailMaster X4 launch poster" />
        <figcaption>AI-generated launch picture</figcaption>
      </figure>
    </header>

    <section class="media-grid" aria-label="TrailMaster X4 launch media">
      <figure>
        <img src="/launch/four-seasons.webp" alt="TrailMaster X4 shown for four seasons" />
        <figcaption>AI-generated picture · Four seasons</figcaption>
      </figure>
      <figure>
        <img src="/launch/setup-guide.webp" alt="TrailMaster X4 setup guide" />
        <figcaption>AI-generated picture · Setup guide</figcaption>
      </figure>
    </section>

    <section class="radio" aria-labelledby="radio-heading">
      <div>
        <p class="eyebrow">English radio spot</p>
        <h2 id="radio-heading">Meet the TrailMaster X4</h2>
        <audio controls preload="metadata" src="/launch/trailmaster-radio-en.mp3">
          Your browser does not support the audio element.
        </audio>
        <span class="ai-label">AI-generated voice</span>
      </div>
      <aside aria-label="Radio spot transcript">
        <h3>Captions</h3>
        <p>{radioTranscript}</p>
      </aside>
    </section>
  </article>
</BaseLayout>

<style>
  .launch-header { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: center; }
  .launch-header, .radio { border: 1px solid var(--line); border-radius: 8px; padding: 24px; background: var(--surface-raised); box-shadow: var(--shadow); }
  figure { margin: 0; }
  img { width: 100%; height: 420px; object-fit: contain; }
  figcaption, .ai-label { display: block; margin-top: 8px; font-size: 0.85rem; font-weight: 700; }
  .eyebrow { margin: 0; text-transform: uppercase; font-weight: 700; }
  h1 { margin: 8px 0 16px; font-size: clamp(2.4rem, 6vw, 5rem); line-height: 0.95; }
  h2 { margin: 8px 0 16px; }
  .launch-header a { display: inline-block; margin-top: 12px; border: 1px solid var(--accent); border-radius: 6px; padding: 10px 14px; background: var(--accent); color: var(--accent-contrast); text-decoration: none; font-weight: 700; }
  .media-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin: 24px 0; }
  .media-grid figure { border: 1px solid var(--line); border-radius: 6px; padding: 16px; background: var(--surface); }
  .radio { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  audio { width: min(420px, 100%); margin-top: 8px; }
  aside { border-left: 1px solid var(--line); padding-left: 24px; }
  aside h3 { margin-top: 0; }
  @media (max-width: 700px) { .launch-header, .media-grid, .radio { grid-template-columns: 1fr; } img { height: 300px; } aside { border-left: 0; border-top: 1px solid var(--line); padding-left: 0; padding-top: 16px; } }
</style>
