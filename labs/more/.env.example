# Settings for the More labs (labs/more/*.ipynb).
#
# Most of these are already in the repo's .env if you ran `bash infra/deploy.sh`.
# The notebooks read this file first, then the repo's .env, so you only need what's missing.
#
# 1. Copy this file:   cp labs/more/.env.example labs/more/.env
# 2. Change DEMO_MODE to live when you want to make your own pictures and audio.
#
# Never share or commit your .env file. (It's already in .gitignore.)

# replay = show saved results from examples/ (no Azure needed). live = call the models.
DEMO_MODE=replay

# Your Microsoft Foundry project. deploy.sh writes this to the repo's .env.
# FOUNDRY_PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>

# Image models (01). deploy.sh deploys both in eastus or westus and writes these names.
# MODEL_IMAGE_HERO=MAI-Image-2.6
# MODEL_IMAGE_BULK=MAI-Image-2.6-Flash

# Requests per minute your image deployments allow. Tier 1 is 6.
RATE_LIMIT_RPM=6

# Voice and transcription (02, 03). They come with your Foundry resource; nothing to deploy.
# MODEL_VOICE_HERO=MAI-Voice-2.1
# MODEL_VOICE_FAST=MAI-Voice-2.1-Flash
# MODEL_TRANSCRIBE=MAI-Transcribe-2

# Optional: today's prices from https://aka.ms/MAIModelPricing, so 01 can add up the cost.
PRICE_PER_IMAGE_HERO_USD=
PRICE_PER_IMAGE_BULK_USD=
