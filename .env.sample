# Deployment settings for LAB663. Never put passwords, client secrets or API keys here.
# The Skillable lifecycle fills these values and writes a local .env before building TrailMate.
# Self-guided deployment writes .env through infra/deploy.sh instead.

# Foundry and the two model deployments
FOUNDRY_PROJECT_ENDPOINT=
TRAILMATE_AGENT_NAME=trailmate
TRAILMATE_MODEL_DEPLOYMENT=gpt-5.4
TRAILMATE_SMALL_MODEL_DEPLOYMENT=gpt-5.4-mini

# Tracing
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Extra models from infra/extra-models.json. Each entry names its own variable.
MAI_IMAGE_DEPLOYMENT=
MAI_IMAGE_FLASH_DEPLOYMENT=

# Azure deployment details
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=
AZURE_AI_ACCOUNT_NAME=
AZURE_AI_PROJECT_NAME=
AZURE_LOCATION=eastus
LAB663_DELIVERY_MODE=skillable
